{
  "manifest_version": 3,
  "name": "YT Music 歌詞シンクロ",
  "version": "1.9.6",
  "description": "補正の全削除前に確認を表示し、歌詞検索と複数ポイント補正に対応。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*",
    "https://www.lrclib.net/*",
    "https://lyrics.api.dacubeking.com/*",
    "https://lyrics-api.boidu.dev/*",
    "https://unison.boidu.dev/*",
    "https://lyrics-api.binimum.org/*",
    "https://lyrics-storage.binimum.org/*",
    "https://karalyr.com/*",
    "https://www.karalyr.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "player-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Music 歌詞シンクロ",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
