{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "YT Music 歌詞シンクロ ベータ（Music Glass）",
  "version": "2.7.31",
  "description": "歌詞候補の固定、ローカルLRC、同期歌詞作成、診断情報のコピーに対応。",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*",
    "https://www.lrclib.net/*",
    "https://lyrics.api.dacubeking.com/*",
    "https://lyrics-api.boidu.dev/*",
    "https://unison.boidu.dev/*",
    "https://lyrics-api.binimum.org/*",
    "https://lyrics-storage.binimum.org/*",
    "https://karalyr.com/*",
    "https://www.karalyr.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "player-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css",
        "theme.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "css": [
        "music-glass.css"
      ],
      "js": [
        "music-glass.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Music 歌詞シンクロ",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/readings/english.json"
      ],
      "matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "version_name": "2.7.31-beta.18"
}
