{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "YT Music 歌詞シンクロ",
  "version": "2.9.1",
  "description": "同期歌詞・ふりがな・曲別表示設定・ローマ字・全画面歌詞に対応。",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*",
    "https://www.lrclib.net/*",
    "https://lyrics.api.dacubeking.com/*",
    "https://lyrics-api.boidu.dev/*",
    "https://unison.boidu.dev/*",
    "https://karalyr.com/*",
    "https://www.karalyr.com/*",
    "https://lrc.red/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "player-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css",
        "theme.css",
        "lyrics-position.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "css": [
        "music-glass.css",
        "player-bar-rounded.css",
        "player-page-reveal.css",
        "player-header-hover.css",
        "lyrics-return-button.css",
        "header-divider.css",
        "lyrics-panel-lift.css"
      ],
      "js": [
        "music-glass.js",
        "player-bar-toggle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Music 歌詞シンクロ",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [],
  "version_name": "2.9.1"
}
